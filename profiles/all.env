# Framework
PATCH_FRAMEWORK=1
fix_apksign=1
tool_box=1
fix_enforce=1

# CN ROM
PATCH_CN_ROM=1
fix_noti=1
settings_infor=1
settings_show=1
settings_icons=1
sceen_lock=1
dark_show=1
open_app=1
font_fix=1

# Advanced keyboard
PATCH_KEYBOARD=1
ime_app=com.google.android.inputmethod.latin
app_ime=1
ime_color='#f0f3f8'
ime_color_dark='#1e1f21'
ime_dimen=''

# Other patches
PATCH_OTHERS=1
fix_screen=1
fix_fps=1
fix_reset_theme=1
fix_show_error=1
fix_fpscam=1
fix_window=1
app_setup=1
fix_data=1

# App patches
PATCH_APPS=1
fix_themes=1
fix_appvault=1
fix_thoit=1
fix_joyose=1
fix_mapcn=1
fix_gmscn=1
fix_off_10s=1

# Add apps
ADD_APPS=1
add_app=1
add_app_2=1
app_playstore=1
app_restore=1
app_velvet=1
app_auto=1
app_tts=1
app_carrier=1
app_gps=1
app_monet=1

# boot/vendor_boot
PATCH_BOOT=1
fix_fake_lock=1
# 0=default, 1=enforcing, 2=permissive, 3=disabled
fix_diselinux=0
